{
  "name": "built-in-saudi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Built in Saudi — free, privacy-first online tools.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-preflight.mjs",
    "predev": "node scripts/copy-ocr-core.mjs",
